# ========= HHT-PrismEdu 环境配置 =========
# 用法：cp .env.example .env 后填入真实值（LLM_API_KEY 必填，其余默认值与 docker-compose.yml 对齐）

# ---- PostgreSQL 16（业务表 + LangGraph checkpointer 同库）----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=prismedu
POSTGRES_PASSWORD=prismedu_dev_2026
POSTGRES_DB=prismedu

# ---- Neo4j 5.26（知识点图谱）----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=prismedu neo4j 2026

# ---- Milvus standalone（向量检索，维度 1024）----
# 维度 1024 是 EMBED_MODEL 的输出维度（BGE-M3 与 text-embedding-v3 同维），由 app/core/config.py 的 embed_dim 统一
MILVUS_URI=http://localhost:19530

# ---- Redis（登录失败计数，多 worker 共享）----
# 留空 = 只用进程内存（单 worker 够用；多 worker 时每个进程各记各的，锁定容易凑不齐）
# 填了就走 Redis；连不上会自动降级回内存并打 warning，登录不会因 Redis 故障而失败
# 端口用 6380：本机可能已有别的 Redis 占着 6379（docker-compose.yml 里已按 6380 映射）
REDIS_URL=redis://localhost:6380/0
# auto（有 url 就用）/ redis（强制）/ memory（强制内存）
LOGIN_GUARD_BACKEND=auto

# ---- LLM（DeepSeek 官方 API 直连，OpenAI 兼容协议）----
# 注意：base_url 填 https://api.deepseek.com 即可，OpenAI SDK 会自动拼 /chat/completions
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=在此填入你的 DeepSeek API Key
LLM_MODEL=deepseek-v4-flash

# ---- Langfuse（Agent 链路观测，监控第二层）----
# 先起容器拿 UI：docker compose up -d langfuse langfuse-db → http://localhost:3100
# 注册账号 → 建项目 → Settings → API Keys，把两个 key 填在这里
# 两个 key 都留空 = 观测关闭，所有接口行为不变（零开销）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3100
# 注意：搬到学校内网服务器后，LANGFUSE_HOST 和 docker-compose 里 langfuse 的
# NEXTAUTH_URL 都要改成 http://<服务器IP>:3100，否则浏览器访问登录页会跳转失败

# ---- 使用周报（监控第一层的定时推送，每周一早 8 点发邮件）----
# 四项 SMTP 任一留空 = 周报定时任务整体不启动；授权码与 Kuma 通知里配的是同一套
# （邮箱后台开 SMTP 领的 16 位授权码，不是邮箱登录密码）
REPORT_EMAIL_HOST=smtp.qq.com
REPORT_EMAIL_PORT=465
REPORT_EMAIL_USER=
REPORT_EMAIL_PASSWORD=
REPORT_EMAIL_TO=
# 发送时机：周几（mon/tue/...）+ 几点（本地时区 Asia/Shanghai）
REPORT_DAY_OF_WEEK=mon
REPORT_HOUR=8

# ---- Embedding（入库时用：本地模型目录 或 云端模型名，二选一）----
# 本地模型：填模型目录的绝对路径（BGE-M3，输出 1024 维）
# 云端模型：填模型名（如 text-embedding-v3），此时必须另配 DASHSCOPE_API_KEY
# 注意：这里不给默认模型名——换向量模型就是换向量空间，配置缺失时代码会直接报错，不会静默用错模型
EMBED_MODEL=
EMBED_DIM=1024
# DASHSCOPE_API_KEY=
