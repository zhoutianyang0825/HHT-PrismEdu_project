# ========= HHT-PrismEdu 环境配置 =========
# 用法：cp .env.example .env 后填入真实值（LLM_API_KEY 必填，其余默认值与 docker-compose.yml 对齐）

# ---- PostgreSQL 16（业务表 + LangGraph checkpointer 同库）----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=prismedu
POSTGRES_PASSWORD=prismedu_dev_2026
POSTGRES_DB=prismedu

# ---- Neo4j 5.26（知识点图谱）----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=prismedu neo4j 2026

# ---- Milvus standalone（向量检索，维度 1024 = DashScope text-embedding-v3）----
MILVUS_URI=http://localhost:19530

# ---- LLM（DeepSeek 官方 API 直连，OpenAI 兼容协议）----
# 注意：base_url 填 https://api.deepseek.com 即可，OpenAI SDK 会自动拼 /chat/completions
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=在此填入你的 DeepSeek API Key
LLM_MODEL=deepseek-v4-flash

# ---- Embedding（M1 入库时使用，先占位）----
EMBED_MODEL=text-embedding-v3
EMBED_DIM=1024
